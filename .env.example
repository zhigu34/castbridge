# CastBridge 本地部署配置
CASTBRIDGE_WEB_PORT=8090
TZ=Asia/Shanghai

# 后端运行环境
CASTBRIDGE_ENVIRONMENT=production
CASTBRIDGE_RECEIVER_NAME=CastBridge
CASTBRIDGE_LOG_LEVEL=INFO
CASTBRIDGE_RECEIVER_STALE_SECONDS=10

# AirPlay / UxPlay
# 默认使用官方最新稳定 Release；1.74 目前仍是 Experimental master，不作为默认生产版本。
UXPLAY_VERSION=1.73.7
CASTBRIDGE_AIRPLAY_PORT=7100
CASTBRIDGE_RTP_VIDEO_PORT=5000
CASTBRIDGE_RTP_AUDIO_PORT=5002

# mDNS / Bonjour 服务发现模式：
# auto     = 优先复用宿主机 Avahi；宿主不可用时自动启用 Receiver 内置 Avahi（推荐）
# host     = 强制复用宿主机 Avahi，需要宿主 /run/dbus/system_bus_socket 且 org.freedesktop.Avahi 正常
# embedded = 强制使用 Receiver 内置 D-Bus + Avahi
CASTBRIDGE_MDNS_MODE=auto

# UxPlay 源码先由 deploy.sh 下载到 vendor/uxplay，再 COPY 进入 Receiver 镜像。
# 留空时使用官方 GitHub 对应 release tag 源码包；后续部署会直接复用本地缓存。
UXPLAY_SOURCE_URL=
# 可选：填写可信来源提供的 SHA256；留空时执行 tar 结构校验。
UXPLAY_SHA256=

# 本地构建加速（默认优先适配国内网络）
DEBIAN_MIRROR=http://mirrors.aliyun.com/debian
DEBIAN_SECURITY_MIRROR=http://mirrors.aliyun.com/debian-security
PYPI_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
NPM_REGISTRY=https://registry.npmmirror.com

# Docker 基础镜像地址。可替换为你自己的可信镜像仓库/代理完整镜像名。
DEBIAN_BASE_IMAGE=debian:bookworm-slim
PYTHON_BASE_IMAGE=python:3.12-slim
NODE_BASE_IMAGE=node:22-alpine
NGINX_BASE_IMAGE=nginx:1.27-alpine

# Docker build 的 HTTP(S) 代理；留空表示直连。
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
